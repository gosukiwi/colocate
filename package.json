{
  "name": "colocate",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Federico Ramirez",
  "type": "module",
  "bin": {
    "colocate": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:placement": "tsx scripts/check-placement.ts",
    "crap": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov && crap4ts src --coverage ./coverage/lcov.info --max-crap 15",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src tests scripts",
    "colocate": "tsx src/bin.ts"
  },
  "dependencies": {
    "minimatch": "^11.0.9",
    "typescript": "^5 || ^6"
  },
  "devDependencies": {
    "@gosukiwi/crap4ts": "^0.2.2",
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5 || ^6",
    "vitest": "^5.1.1"
  }
}
